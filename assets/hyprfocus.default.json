{
  "version": 1,
  "base": {
    "workspaces": [
      "code",
      "creative",
      "proton",
      "media",
      "gaming",
      "logs",
      "misc",
      "comms",
      "music",
      "ankama"
    ],
    "bindings": [
      "dofus"
    ],
    "services": [
      "theme-auto",
      "obsidian",
      "obsidian-index",
      "linear-sync",
      "state-backup",
      "chezmoi",
      "audio-notify"
    ],
    "projects": [],
    "requires": {
      "binding:dofus": [
        "workspace:gaming"
      ]
    },
    "notify": {
      "default": "show"
    },
    "scenes": {
      "gaming": {
        "blocks": [
          {
            "classes": [
              "Dofus.x64"
            ],
            "order": 1,
            "group": true,
            "share": 0.67,
            "collect": true
          },
          {
            "classes": [
              "zen-gaming-media"
            ],
            "order": 2,
            "share": 0.33,
            "guard": "deny"
          }
        ],
        "barred": [
          "steam_app_default",
          "steam_app_\\d+",
          "Ankama Launcher"
        ]
      },
      "code": {
        "blocks": [
          {
            "classes": [
              "Kitty-Main",
              "Proj-[A-Za-z0-9_-]+"
            ],
            "order": 1,
            "group": true,
            "share": 0.67
          },
          {
            "classes": [
              "zen-twilight",
              "firefox-developer-edition"
            ],
            "order": 2,
            "share": 0.33
          }
        ]
      }
    },
    "wants": {
      "service:obsidian": [
        "service:obsidian-index",
        "service:linear-sync"
      ]
    }
  },
  "modes": {
    "neutral": {
      "name": "Neutral",
      "presentation": {
        "accent_role": "lavender",
        "surface_alpha": 0.84,
        "density": "comfortable",
        "motion_energy": "base",
        "bar_autohide": false
      },
      "bindings": {
        "remove": [
          "dofus"
        ]
      }
    },
    "work": {
      "name": "Work",
      "workspaces": {
        "remove": [
          "gaming",
          "media",
          "music"
        ]
      },
      "bindings": {
        "remove": [
          "dofus"
        ]
      },
      "notify": {
        "default": "queue"
      },
      "presentation": {
        "accent_role": "blue",
        "surface_alpha": 0.94,
        "density": "compact",
        "motion_energy": "instant",
        "bar_autohide": true
      }
    },
    "study": {
      "name": "Study",
      "workspaces": {
        "remove": [
          "gaming",
          "media",
          "music"
        ]
      },
      "bindings": {
        "remove": [
          "dofus"
        ]
      },
      "notify": {
        "default": "queue"
      },
      "presentation": {
        "accent_role": "blue",
        "surface_alpha": 0.94,
        "density": "compact",
        "motion_energy": "instant",
        "bar_autohide": true
      }
    },
    "gaming": {
      "name": "Gaming",
      "workspaces": {
        "only": [
          "gaming",
          "comms",
          "ankama",
          "logs"
        ]
      },
      "services": {
        "remove": [
          "obsidian",
          "obsidian-index",
          "linear-sync"
        ]
      },
      "notify": {
        "default": "drop",
        "im": "drop",
        "linear-sync": "queue"
      },
      "presentation": {
        "accent_role": "green",
        "surface_alpha": 0.96,
        "density": "compact",
        "motion_energy": "instant",
        "bar_autohide": false
      }
    }
  }
}
