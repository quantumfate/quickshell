  "modes": {
    "neutral": {
      "name": "Neutral",
      "presentation": {
        "accent_role": "peach",
        "surface_alpha": 0.84,
        "density": "comfortable",
        "motion_energy": "base",
        "bar_autohide": false
      },
      "bindings": {
        "remove": ["dofus"]
      }
    },
    "work": {
      "name": "Work",
      "workspaces": {
        "remove": ["dofus", "pokemon", "steam-games", "communication", "lutris", "steam", "media", "ankama-launcher", "creative", "misc"]
      },
      "bindings": {
        "remove": ["dofus"]
      },
      "notify": {
        "default": "queue"
      },
      "presentation": {
        "accent_role": "blue",
        "surface_alpha": 0.94,
        "density": "compact",
        "motion_energy": "instant",
        "bar_autohide": true
      }
    },
    "study": {
      "name": "Study",
      "workspaces": {
        "remove": ["dofus", "pokemon", "steam-games", "communication", "lutris", "steam", "media", "ankama-launcher", "creative", "misc", "logs"]
      },
      "bindings": {
        "remove": ["dofus"]
      },
      "notify": {
        "default": "queue"
      },
      "presentation": {
        "accent_role": "red",
        "surface_alpha": 0.94,
        "density": "compact",
        "motion_energy": "instant",
        "bar_autohide": true
      }
    },
    "gaming": {
      "name": "Gaming",
      "workspaces": {
        "only": ["dofus", "pokemon", "steam-games", "communication", "lutris", "steam", "media", "ankama-launcher"]
      },
      "services": {
        "remove": ["obsidian", "obsidian-index", "linear-sync"]
      },
      "notify": {
        "default": "drop",
        "im": "drop",
        "linear-sync": "queue"
      },
      "presentation": {
        "accent_role": "lavender",
        "surface_alpha": 0.96,
        "density": "compact",
        "motion_energy": "instant",
        "bar_autohide": false
      }
    }
  }
