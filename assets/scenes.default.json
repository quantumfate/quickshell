{
  "scenes": {
    "code": {
      "layout": "dwindle",
      "layout_opts": {
        "dwindle": { "default_split_ratio": 0.67 },
        "scrolling": { "column_width": 0.67 }
      },
      "group_default": "always",
      "bindings": ["code"],
      "reevaluate_on": ["window.open", "workspace.active"],
      "members": [
        {
          "match": { "class": "Proj-[A-Za-z0-9_-]+" },
          "group": true,
          "props": { "group": "set always" },
          "bindings": ["code"]
        },
        {
          "match": { "class": "Kitty-Main" },
          "group": true,
          "props": { "group": "set always" }
        },
        {
          "match": { "class": "(zen-twilight|zen-beta|firefox-developer-edition)" },
          "props": { "group": "barred" }
        }
      ],
      "geometry": {
        "laptop-solo": { "layout": "monocle" }
      }
    },
    "gaming": {
      "layout": "dwindle",
      "gaps": { "in": 0, "out": 0 },
      "border_size": 0,
      "decorate": false,
      "group_default": "always",
      "bindings": ["gaming"],
      "reevaluate_on": ["window.open"],
      "members": [
        {
          "match": { "initial_class": "Dofus.x64" },
          "group": true,
          "props": {
            "workspace": "name:gaming",
            "group": "set always",
            "center": true,
            "content": "game",
            "opacity": "1.0 override",
            "no_anim": true,
            "suppress_event": "fullscreen"
          },
          "bindings": ["gaming"]
        },
        {
          "match": { "class": "Ankama Launcher", "title": "overlay" },
          "props": {
            "workspace": "name:gaming",
            "float": true,
            "center": true
          }
        },
        {
          "match": { "class": "net.lutris.Lutris" },
          "props": { "size": ["monitor_w * 0.35", "monitor_h * 0.8"] }
        },
        {
          "match": { "class": "zen-gaming-media" },
          "props": { "group": "barred" }
        }
      ]
    },
    "media": {
      "layout": "dwindle",
      "bindings": ["media"],
      "members": [
        {
          "match": { "class": "zen-twilight-media" },
          "props": { "opacity": "1.0 override" }
        },
        {
          "match": {
            "class": "(zoom|vlc|mpv|mp4|org.kde.kdenlive|com.obsproject.Studio|org.gnome.NautilusPreviewer)"
          },
          "props": { "opacity": "1 1" }
        }
      ]
    }
  }
}